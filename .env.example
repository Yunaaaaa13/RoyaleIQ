# PostgreSQL (Prisma). Required for persistence: players, battles, snapshots.
# Local dev: postgresql://postgres:PASSWORD@localhost:5432/royaleiq?schema=public
DATABASE_URL=

# Clash Royale API — create a key at https://developer.clashroyale.com
# Required for live player profiles, battle logs and meta aggregation.
CLASH_ROYALE_API_TOKEN=

# Optional overrides
# Must include the API version. Defaults to https://api.clashroyale.com/v1.
# CLASH_ROYALE_API_BASE=https://api.clashroyale.com/v1
# RoyaleAPI proxy (keeps your own IP off the allowlist) - the `/v1` is required:
# CLASH_ROYALE_API_BASE=https://proxy.royaleapi.dev/v1
# Players sampled for one meta snapshot (each costs one battlelog request).
# META_PLAYER_POOL=10
# Client-side throttle, requests/minute. Raise cautiously - the key itself
# is throttled by Supercell.
# CR_RATE_LIMIT_PER_MINUTE=12
# Outbound request hardening: total tries per request and per-attempt timeout.
# Network blips and 429/5xx are retried with exponential backoff + jitter.
# HTTP_RETRY_ATTEMPTS=4
# HTTP_TIMEOUT_MS=15000

# LLM for the AI Deck Coach (OpenAI-compatible endpoint).
# Without it the coach falls back to the deterministic rule engine.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
